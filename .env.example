DATABASE_MODE=LOCAL
# SUPABASE modunda DATABASE_URL Supabase session pooler URL ve schema=saha olmalı.
DATABASE_URL=postgresql://drone:CHANGE_LOCAL_DB_PASSWORD@localhost:5432/drone?schema=public
POSTGRES_USER=drone
POSTGRES_PASSWORD=CHANGE_LOCAL_DB_PASSWORD
POSTGRES_DB=drone
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
SESSION_HOURS=12
# Uygulama kullanıcıları CLI ile oluşturulur. Gerçek parola bu dosyaya yazılmaz.
# Kullanıcı oluşturma / demo seed çalıştırırken USER_EMAIL, USER_NAME, USER_ROLE,
# USER_PASSWORD veya SEED_PASSWORD ortam değişkenlerini geçici olarak ayarlayın.
# Açıkça yapılandırılmazsa harita döşemesi yüklenmez.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
# Optional Supabase PostgreSQL session pooler; server-only, password URL-encoded.
# Active DATABASE_URL remains local until a verified migration and explicit switch.
SUPABASE_DATABASE_URL=
# Parsel modülü: isteğe bağlı lisanslı HTTPS XYZ uydu sağlayıcısı.
# Üç alan birlikte gereklidir. URL içindeki anahtar yalnız sunucuda kalır.
PARCEL_SATELLITE_TILE_URL=
PARCEL_SATELLITE_ATTRIBUTION=
PARCEL_SATELLITE_LICENSE_REFERENCE=

# Gerçek parsel adaptörü: kullanım yetkisi doğrulandıktan sonra TKGM seçilir.
PARCEL_PROVIDER=DEMO
PARCEL_USAGE_AUTHORIZATION_REFERENCE=


# Yalnız localhost geliştirme testi: PARCEL_PROVIDER=TKGM_LOCAL_TEST
# NODE_ENV=development ve APP_ORIGIN localhost olmalı; kullanım izni anlamına gelmez.


# HGM Atlas: işletmeye ait anahtar yalnız sunucuda saklanır, VITE_ öneki kullanmayın.
MAP_PROVIDER=HGM_ATLAS
HGM_ATLAS_API_KEY=


# MapTiler uydu: anahtar yalnız sunucuda, MAP_PROVIDER=MAPTILER seçilir.
MAPTILER_API_KEY=


# WeatherAPI: anahtar server-only. Ücretsiz plan3 gün; 7 gün için uygun abonelik gerekir.
WEATHERAPI_KEY=
WEATHERAPI_FORECAST_DAYS=3
WEATHER_PROVIDER=OPEN_METEO
# Ücretsiz API yalnız geliştirme/araştırma içindir; production ortamında kapalıdır.
WEATHER_USAGE_MODE=RESEARCH

# Yol servisi: anahtar server-only; hesabınızın kullanım koşullarını inceleyin.
ORS_API_KEY=
# İsteğe bağlı: incelenen hesap planı/koşulları ve inceleme tarihi.
ORS_USAGE_AUTHORIZATION_REFERENCE=
# Teknik eşleme kontrolü: seçili girişten daha uzakta yola eşlenirse reddet.
ORS_MAX_SNAP_DISTANCE_METERS=200


# Vercel: bkz. VERCEL_YAYIN.md. Gerçek adresi panelde APP_ORIGIN olarak ayarlayın.
# NODE_ENV=production; DATABASE_MODE=SUPABASE; DATABASE_URL uzak DB, schema=saha.
# Build: npm run vercel:build. Seed/migration build sırasında otomatik çalışmaz.
