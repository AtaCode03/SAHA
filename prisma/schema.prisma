generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  ADMIN
  OPERATOR
}
enum Status {
  REQUESTED
  PLANNED
  RUNNING
  COMPLETED
  POSTPONED
  CANCELLED
}
enum Source {
  REAL
  SYNTHETIC
}
enum EventKind {
  PREPARATION
  FLIGHT_START
  FLIGHT_END
  REFILL
  BATTERY
  WAIT_START
  WAIT_END
  COMPLETE
}
enum ExpenseKind {
  TRANSPORT
  ENERGY
  LABOR
  CONSUMABLE
  OTHER
}
model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  role Role
  active Boolean @default(true)
  sessions Session[]
  assignments WorkOrder[]
  events OperationEvent[]
  audits AuditLog[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@map("users")
}
model Session {
  id String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  csrf String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
model Customer {
  id String @id @default(uuid())
  researchId String @unique @default(uuid())
  name String
  phone String
  neighborhood String
  notes String?
  active Boolean @default(true)
  source Source @default(REAL)
  fields Field[]
  orders WorkOrder[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([active,name])
  @@map("customers")
}
model Field {
  id String @id @default(uuid())
  researchId String @unique @default(uuid())
  customerId String
  customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict)
  name String
  province String @default("Konya")
  district String @default("Seydişehir")
  neighborhood String
  block String?
  parcel String?
  area Decimal? @db.Decimal(12,3)
  areaOrigin String?
  crop String?
  latitude Float?
  longitude Float?
  boundary Json?
  accessNotes String?
  active Boolean @default(true)
  source Source @default(REAL)
  orders WorkOrder[]
  @@index([customerId,active])
  @@map("fields")
}
model Drone {
  id String @id @default(uuid())
  name String
  model String
  tankLiters Decimal? @db.Decimal(10,3)
  active Boolean @default(true)
  orders WorkOrder[]
  @@map("drones")
}
model WorkOrder {
  id String @id @default(uuid())
  researchId String @unique @default(uuid())
  customerId String
  customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict)
  fieldId String
  field Field @relation(fields:[fieldId],references:[id],onDelete:Restrict)
  operatorId String?
  operator User? @relation(fields:[operatorId],references:[id],onDelete:Restrict)
  droneId String?
  drone Drone? @relation(fields:[droneId],references:[id],onDelete:Restrict)
  requestedAt DateTime @default(now()) @db.Timestamptz(3)
  plannedStart DateTime? @db.Timestamptz(3)
  plannedEnd DateTime? @db.Timestamptz(3)
  sequence Int @default(0)
  service String
  plannedArea Decimal @db.Decimal(12,3)
  actualArea Decimal? @db.Decimal(12,3)
  actualAreaOrigin String?
  agreedPrice Decimal @db.Decimal(14,2)
  adjustment Decimal @default(0) @db.Decimal(14,2)
  snapshot Json
  notes String?
  status Status @default(REQUESTED)
  reason String?
  completedAt DateTime? @db.Timestamptz(3)
  source Source @default(REAL)
  events OperationEvent[]
  expenses Expense[]
  payments Payment[]
  predictions PredictionSnapshot[]
  @@index([operatorId,status,plannedStart])
  @@index([droneId,plannedStart])
  @@index([status,completedAt])
  @@map("work_orders")
}
model OperationEvent {
  id String @id @default(uuid())
  orderId String
  order WorkOrder @relation(fields:[orderId],references:[id],onDelete:Restrict)
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  kind EventKind
  at DateTime @db.Timestamptz(3)
  idempotencyKey String
  payloadHash String
  origin String @default("MEASURED")
  @@unique([orderId,idempotencyKey])
  @@index([orderId,at])
  @@map("operation_events")
}
model Expense {
  id String @id @default(uuid())
  orderId String?
  order WorkOrder? @relation(fields:[orderId],references:[id],onDelete:Restrict)
  kind ExpenseKind
  amount Decimal @db.Decimal(14,2)
  at DateTime @db.Timestamptz(3)
  note String?
  allocationGroup String?
  allocationRule String @default("DIRECT")
  @@index([at,orderId])
  @@map("expenses")
}
model Payment {
  id String @id @default(uuid())
  orderId String
  order WorkOrder @relation(fields:[orderId],references:[id],onDelete:Restrict)
  amount Decimal @db.Decimal(14,2)
  at DateTime @db.Timestamptz(3)
  note String?
  idempotencyKey String @unique
  @@index([orderId,at])
  @@map("payments")
}
model AuditLog {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  entity String
  entityId String
  action String
  before Json?
  after Json?
  reason String?
  at DateTime @default(now()) @db.Timestamptz(3)
  @@index([entity,entityId,at])
  @@map("audit_logs")
}
model PredictionSnapshot {
  id String @id @default(uuid())
  orderId String
  order WorkOrder @relation(fields:[orderId],references:[id],onDelete:Restrict)
  input Json
  method String
  version String
  minutes Decimal? @db.Decimal(12,3)
  at DateTime @default(now()) @db.Timestamptz(3)
  @@map("prediction_snapshots")
}
model ModelVersion {
  id String @id @default(uuid())
  version String @unique
  metadata Json
  validated Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@map("model_versions")
}
model ResearchExport {
  id String @id @default(uuid())
  version String
  count Int
  manifest Json
  at DateTime @default(now()) @db.Timestamptz(3)
  @@map("research_exports")
}
