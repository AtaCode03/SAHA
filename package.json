{
  "name": "seydisehir-drone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "local": "npm run build && tsx scripts/local-start.ts",
    "supabase:check": "tsx scripts/supabase-transfer.ts check",
    "supabase:sql": "tsx scripts/build-supabase-sql.ts",
    "test:supabase-sql": "npm run supabase:sql && tsx scripts/test-postgres.ts --supabase-sql",
    "supabase:backup": "tsx scripts/supabase-transfer.ts backup",
    "supabase:transfer": "tsx scripts/supabase-transfer.ts transfer",
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "user:create": "tsx scripts/create-user.ts",
    "test:integration": "tsx scripts/integration.ts",
    "test:postgres": "tsx scripts/test-postgres.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@turf/turf": "7.3.0",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "decimal.js": "10.6.0",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "leaflet": "1.9.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/leaflet": "1.9.21",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.1.1",
    "@xmldom/xmldom": "0.9.12",
    "autoprefixer": "10.4.22",
    "concurrently": "9.2.5",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "8.23.1",
    "postcss": "8.5.30",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
